# viaframe's vm pane image: a 32-bit x86 (i586) Linux for the v86 emulator, one bzImage with its root file system inside (initramfs).
# Built by vm-image/build.sh with Buildroot 2026.02.3 (pinned). Nothing here reaches the network when the image runs.
BR2_REPRODUCIBLE=y
BR2_x86_i586=y
BR2_OPTIMIZE_S=y
BR2_TOOLCHAIN_BUILDROOT_MUSL=y
# Rust (host-rust-bin's i586-unknown-linux-musl standard library) needs the C++ runtime in the toolchain; the target does not keep it (post-build.sh).
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_ENABLE_LOCALE_PURGE=y
BR2_TARGET_GENERIC_HOSTNAME="viaframe"
BR2_TARGET_GENERIC_ISSUE="viaframe vm image"
BR2_TARGET_GENERIC_ROOT_PASSWD=""
BR2_SYSTEM_BIN_SH_BUSYBOX=y
BR2_INIT_BUSYBOX=y
BR2_TARGET_GENERIC_GETTY=n
BR2_TARGET_GENERIC_REMOUNT_ROOTFS_RW=n
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_VIAFRAME_PATH)/board/viaframe/overlay"
BR2_TARGET_ROOTFS_CPIO=y
BR2_TARGET_ROOTFS_INITRAMFS=y
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_LATEST_VERSION=y
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_VIAFRAME_PATH)/board/viaframe/linux.config"
BR2_LINUX_KERNEL_BZIMAGE=y
BR2_LINUX_KERNEL_XZ=y
BR2_PACKAGE_HOST_RUSTC=y
BR2_PACKAGE_HOST_RUST_BIN=y
BR2_PACKAGE_WSH_SERVER=y
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_VIAFRAME_PATH)/board/viaframe/post-build.sh"
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_VIAFRAME_PATH)/board/viaframe/busybox.fragment"
