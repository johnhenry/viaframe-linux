# Kernel options layered on `make ARCH=i386 tinyconfig` (vm-image/regen-kernel-config.sh). 32-bit, UP, no modules: everything the guest needs is built in.
CONFIG_M586TSC=y
CONFIG_HZ_100=y
CONFIG_PRINTK=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_KERNEL_XZ=y
CONFIG_RD_XZ=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_SHMEM=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TTY=y
CONFIG_UNIX98_PTYS=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_PCI=y
CONFIG_PCI_QUIRKS=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_NET=y
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_VIRTIO_NET=y
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_9P_FS=y
CONFIG_9P_FS_POSIX_ACL=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_VGA_CONSOLE=y
CONFIG_INPUT=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_INPUT_MOUSE=y
CONFIG_MOUSE_PS2=y
CONFIG_SERIO=y
CONFIG_SERIO_I8042=y
CONFIG_INPUT_EVDEV=y
CONFIG_RTC_CLASS=n
# nothing to load, nothing to debug
CONFIG_MODULES=n
CONFIG_DEBUG_KERNEL=n
CONFIG_IKCONFIG=n
CONFIG_WIRELESS=n
# What a Rust (tokio) program needs and tinyconfig leaves out: futexes (std's mutexes and thread parking), epoll, eventfd/timerfd/signalfd (mio, tokio's timers and signals), POSIX timers, advise (the allocator), file locks, sysctl.
CONFIG_EXPERT=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_EVENTFD=y
CONFIG_TIMERFD=y
CONFIG_SIGNALFD=y
CONFIG_POSIX_TIMERS=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_FILE_LOCKING=y
CONFIG_MULTIUSER=y
CONFIG_PROC_SYSCTL=y
